# Copy to .env for local development. Never commit real keys.
PORT=3000

# LLM provider settings
# MEALPILOT_LLM_MODE: 'auto' (default: uses Gemini if key set, else mock), 'live', or 'mock'
MEALPILOT_LLM_MODE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# YouTube Data API v3 (optional; enables discovery & video metadata enrichment)
YOUTUBE_API_KEY=

# Agent run budgets & limits
AGENT_MAX_STEPS=12
AGENT_MAX_ANALYSES=8
AGENT_MAX_SEARCHES=4
AGENT_TIMEOUT_MS=90000
ANALYSIS_CONCURRENCY=3

# S3-compatible storage (e.g. Neon S3). Never commit real keys.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Neon Postgres (eu-central-1). Empty DATABASE_URL keeps the file cache.
# DATABASE_URL: pooled host (...-pooler...), used by the app.
# DATABASE_URL_DIRECT: direct host, used only for migrations (drizzle-kit and
# startup migrations). Both need sslmode=require on Neon.
# Local option: docker compose up -d postgres, then
#   DATABASE_URL=postgres://mealpilot:mealpilot@localhost:5432/mealpilot
DATABASE_URL=
DATABASE_URL_DIRECT=

# USDA FoodData Central key (free: https://fdc.nal.usda.gov/api-key-signup).
# Empty disables nutrient calculation; analyses then carry nutrition: null.
FDC_API_KEY=

# Optional: override runtime cache directory (default: data/cache).
MEALPILOT_CACHE_DIR=

# Optional: team-reviewed trusted channels list (default: data/trusted-channels.json).
TRUSTED_CHANNELS_FILE=
