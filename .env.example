# Copy to .env for local development (loaded automatically by @nestjs/config).
# Never commit real keys.
PORT=3000

# --- Gemini ---------------------------------------------------------------
# auto (default): live if GEMINI_API_KEY is set, otherwise offline mock.
# live: require a key (boot fails without one). mock: never call Gemini.
MEALPILOT_LLM_MODE=auto
GEMINI_API_KEY=
# Agent + analysis model (https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.8-flash
# Optional: separate (e.g. cheaper) model for per-video analysis
GEMINI_ANALYSIS_MODEL=
# Video input resolution: low | medium | high (low = cheapest)
GEMINI_VIDEO_RESOLUTION=low
GEMINI_TIMEOUT_MS=120000

# --- YouTube Data API v3 (optional, enables search) ------------------------
YOUTUBE_API_KEY=
# Stop before this many quota units/day (default project quota: 10,000; search = 100)
YOUTUBE_DAILY_QUOTA=9000
# Optional ISO 3166-1 region for search, e.g. AT
YOUTUBE_REGION=
MAX_VIDEO_MINUTES=25

# --- Agent budgets ---------------------------------------------------------
AGENT_MAX_STEPS=12
AGENT_MAX_SEARCHES=4
AGENT_MAX_ANALYSES=8
AGENT_TIMEOUT_MS=150000
ANALYSIS_CONCURRENCY=3

# --- Cache -----------------------------------------------------------------
# Runtime cache directory (default: data/cache). 0 = never expire.
MEALPILOT_CACHE_DIR=
CACHE_TTL_DAYS=30
